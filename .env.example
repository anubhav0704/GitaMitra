# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gitamitra
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Session Settings
SECRET_KEY=change-this-to-a-secure-64-character-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting & Cost Protection
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=20/minute
VOICE_RATE_LIMIT=15/minute
MAX_MESSAGE_LENGTH=2000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Provider Configuration
LLM_PROVIDER=groq # Options: groq, openai, gemini, mock
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
CHAT_HISTORY_LIMIT=6

# Voice Interaction Configuration
VOICE_ENABLED=true
STT_PROVIDER=groq # Options: groq, openai, mock
STT_MODEL=whisper-large-v3
STT_API_KEY=
TTS_PROVIDER=mock # Options: openai, elevenlabs, edge, mock
TTS_MODEL=tts-1
TTS_API_KEY=
TTS_VOICE=onyx
VOICE_LANGUAGE=auto
VOICE_MAX_DURATION_SECONDS=60
VOICE_MAX_FILE_SIZE_MB=10
VOICE_CACHE_ENABLED=true

# Error Tracking & Metrics
ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_DSN=
