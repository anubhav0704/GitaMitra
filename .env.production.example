# Production Database Configuration
POSTGRES_USER=gitamitra_admin
POSTGRES_PASSWORD=generate-strong-random-db-password-here
POSTGRES_DB=gitamitra_prod
POSTGRES_SERVER=db
POSTGRES_PORT=5432
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Strict Security & Session Settings
SECRET_KEY=MUST_SET_HIGH_ENTROPY_64_CHAR_HEX_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=https://gitamitra.com,https://www.gitamitra.com

# Rate Limiting & Cost Protection
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=20/minute
VOICE_RATE_LIMIT=15/minute
MAX_MESSAGE_LENGTH=2000

# Production Frontend URL
NEXT_PUBLIC_API_URL=https://gitamitra.com

# AI Provider API Keys
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-production-openai-api-key
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
CHAT_HISTORY_LIMIT=6

# Production Voice Settings
VOICE_ENABLED=true
STT_PROVIDER=openai
STT_MODEL=whisper-1
STT_API_KEY=your-production-openai-api-key
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_API_KEY=your-production-openai-api-key
TTS_VOICE=onyx
VOICE_LANGUAGE=auto
VOICE_MAX_DURATION_SECONDS=60
VOICE_MAX_FILE_SIZE_MB=10
VOICE_CACHE_ENABLED=true

# Error Tracking & Observability
ERROR_TRACKING_ENABLED=true
ERROR_TRACKING_DSN=https://your-sentry-dsn@sentry.io/project-id
